# Compose publishes this port on the server's loopback interface.
APP_PORT=3000
# Set to your HTTPS address when deploying behind a reverse proxy.
APP_ORIGIN=http://127.0.0.1:3000
# Set an admin password with at least 16 characters.
ADMIN_PASSWORD=
# Keep this 64-character hex value stable across deployments.
APP_SECRET=
# Optional custom OpenAI-compatible model provider.
MODEL_API_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
